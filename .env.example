# إعدادات خادم اللعب عن بعد (server/relay.mjs) — انسخ الملف إلى .env وعدّل القيم.
# ما بيه أسرار: الخادم ما يحتاج مفاتيح API. لا ترفع ملف .env الحقيقي للمستودع.

# المنفذ والعنوان
PORT=8787
HOST=0.0.0.0

# المواقع المسموح لها تتصل بالخادم (Origin). اتركه فارغ للسماح للكل.
# مثال: ALLOWED_ORIGINS=https://khy.example.com,https://adolsatar-sketch.github.io
ALLOWED_ORIGINS=

# عمر الغرفة الأقصى بالساعات، وكم دقيقة تبقى الغرفة الفارغة قبل ما تنتهي
ROOM_TTL_HOURS=6
ROOM_IDLE_MINUTES=30

# كم ثانية يبقى مقعد اللاعب المنقطع محجوز حتى يرجع لنفس الجولة
SEAT_GRACE_SECONDS=120

# 1 = الخادم يخدم ملفات الموقع أيضاً (أسهل نشر: رابط واحد للموقع واللعب)
# 0 = الخادم للعب فقط، والموقع مستضاف بمكان ثاني (عدّل site.config.js وحط relayUrl)
SERVE_STATIC=1
